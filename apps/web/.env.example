# Copy to .env.local. Everything here is server-side; nothing is NEXT_PUBLIC_.

# ── Postgres ────────────────────────────────────────────────────────────────
# Local:    docker compose -f docker-compose.dev.yml up  (from the repo root)
# Supabase: Settings → Database → Connection string → Transaction pooler (6543)
# Then:     pnpm -C apps/web db:migrate
DATABASE_URL=postgres://rekod:rekod@localhost:5432/rekod

# ── Auth ────────────────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# This app's public origin. Google's redirect URI is <this>/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3100
# Optional. Leave both empty and the Google button does not render.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# true: nobody new can sign up.
DISABLE_SIGNUP=false
# Comma-separated, e.g. yourorg.com. Empty: any domain.
ALLOWED_EMAIL_DOMAINS=

# ── S3-compatible storage ───────────────────────────────────────────────────
# Local SeaweedFS runs with auth off, so any key pair works. Create the bucket
# once:  curl -X PUT http://localhost:8333/rekod
# Supabase: Storage → S3 Connection. Endpoint https://<ref>.supabase.co/storage/v1/s3,
# region from that page, keys from "S3 access keys". Those keys bypass storage
# RLS — server-side only.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=rekod
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
