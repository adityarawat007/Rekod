{
  "name": "viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "node scripts/ext-zip.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "pnpm test:postgres && pnpm test:mongo",
    "test:postgres": "node --experimental-strip-types --no-warnings test-logic.ts && node --conditions=react-server --experimental-strip-types --no-warnings test-tenancy.ts postgres",
    "test:mongo": "node --conditions=react-server --experimental-strip-types --no-warnings test-tenancy.ts mongo",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "set-plan": "node --env-file=.env.local --conditions=react-server --experimental-strip-types --no-warnings scripts/set-plan.ts",
    "ext:zip": "node scripts/ext-zip.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.35.0",
    "mongodb": "^7.7.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.3.8",
    "mongodb-memory-server": "^11.3.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
